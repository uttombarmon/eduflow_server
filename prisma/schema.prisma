generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// enums
enum UserRole {
  student
  tutor
  admin
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseStatus {
  publish
  draft
  archive
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// user model
model User {
  id              String   @id @default(uuid())
  name            String?
  email           String   @unique
  role            UserRole @default(student)
  avatar          String?
  password        String?
  createdAt       DateTime @default(now())
  profile         Profile?
  authoredCourses Course[] @relation("CourseInstructor")
  posts           Post[]

  // Tracking student enrollments and specific lesson completions
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  payments       Payment[]
  quizAttempts   QuizAttempt[]
}

model Profile {
  id          String   @id @default(uuid())
  bio         String?  @db.Text
  headline    String?
  skills      String[]
  hobbies     String[]
  location    String?
  phoneNumber String?
  website     String?
  github      String?
  linkedin    String?
  twitter     String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  experiences Experience[]
  projects    Project[]
  educations  Education[]

  updatedAt DateTime @updatedAt
}

model Experience {
  id          String    @id @default(uuid())
  company     String
  position    String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?   @db.Text

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id           String   @id @default(uuid())
  title        String
  description  String?  @db.Text
  link         String?
  githubLink   String?
  technologies String[]

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Education {
  id           String    @id @default(uuid())
  school       String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model Course {
  id            String       @id @default(uuid())
  title         String
  slug          String       @unique // Essential for SEO (e.g., /courses/react-101)
  description   String       @db.Text // Use Text for longer content
  thumbnail     String
  price         Float // Consider Int (storing cents) if connecting to Stripe
  rating        Float        @default(0)
  studentsCount Int          @default(0)
  level         CourseLevel  @default(BEGINNER)
  status        CourseStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  instructorId String
  instructor   User   @relation("CourseInstructor", fields: [instructorId], references: [id])

  modules     Module[] // Grouped structure
  enrollments Enrollment[]
  payments    Payment[]

  @@index([instructorId])
  @@index([categoryId])
}

// NEW: Groups lessons together (e.g., "Module 1: Getting Started")
model Module {
  id    String @id @default(uuid())
  title String
  order Int    @default(0)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id            String  @id @default(uuid())
  title         String
  content       String? @db.Text
  videoUrl      String?
  durationInSec Int? // Int is better for UI math (e.g., formatting to MM:SS)
  isPublished   Boolean @default(false)
  order         Int     @default(0)

  chapterId String
  chapter   Module @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  quizzes        Quiz[]
  lessonProgress LessonProgress[]

  @@index([chapterId])
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false) // Changed default to false
  completedAt DateTime?

  // Track where they paused the video (optional but great for UX)
  watchTimeSec Int @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Enrollment {
  id           String   @id @default(uuid())
  userId       String
  courseId     String
  progress     Float    @default(0) // 0 to 100 percentage
  lastAccessed DateTime @default(now())
  createdAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Quiz {
  id       String @id @default(uuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  questions QuizQuestion[]
  attempts  QuizAttempt[] // Link to user submissions

  @@index([lessonId])
}

model QuizQuestion {
  id            String   @id @default(uuid())
  question      String
  options       String[]
  correctAnswer Int // Index of the correct option

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

// NEW: Tracks the student's actual performance on a quiz
model QuizAttempt {
  id        String   @id @default(uuid())
  userId    String
  quizId    String
  score     Float // e.g., 80.5 (%)
  passed    Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

model Notification {
  id      String   @id @default(uuid())
  message String
  type    String
  time    DateTime @default(now())
}

model Post {
  id    Int    @id @default(autoincrement())
  title String
  body  String

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Payment {
  id       String        @id @default(uuid())
  amount   Float
  currency String // USD, BDT
  status   PaymentStatus @default(PENDING)
  method   String        @default("MOCK")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
